{% extends "_layouts/base.twig" %}

{% block title %}Projects | Myles Pitfield{% endblock %}
{% block metaDescription %}Explore web development projects by Myles Pitfield, including websites, ecommerce solutions and web applications built using modern web technologies.{% endblock %}

{% block content %}

    {% set heading = 'PROJECTS' %}
    <h1 class="relative text-white text-[clamp(35px,5vw,100px)] font-bold text-center mb-5">
        <span class="sr-only">{{ heading }}</span>
        <span class="typewriter-random" data-word="{{ heading }}" aria-hidden="true"></span>
    </h1>

    <div class="h-[35px]"></div>

    {% set projects = craft.entries().section('projects').orderBy('lft ASC').all() %}
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
        {% for project in projects %}
            <a href="{{ project.url }}" class="group flex flex-col rounded-2xl overflow-hidden border border-white/10 bg-white/[0.04] transition duration-300 hover:-translate-y-1 hover:border-white/20 hover:bg-white/[0.06] hover:shadow-[0_20px_60px_rgba(0,0,0,0.25)]">
                {% set image = project.featuredImage.one() %}
                <div class="aspect-video overflow-hidden py-4 px-6" style="background-color: {{ project.bannerColor ?: '#ffffff' }}">
                    {% if image %}
                        <img class="w-full h-full object-contain transition duration-500 group-hover:scale-[1.04] group-hover:rotate-[0.5deg]" src="{{ image.url }}" alt="{{ image.caption }}">
                    {% endif %}
                </div>
                <div class="p-5 flex flex-col gap-4 flex-1">
                    <div>
                        <div class="flex flex-wrap gap-2 mb-3">
                            {% if project.projectType %}
                                <span class="text-[11px] uppercase tracking-wider text-[#7c7cff] font-semibold">{{ project.projectType }}</span>
                            {% endif %}
                            {% if project.projectStatus %}
                                <span class="text-[11px] uppercase tracking-wider text-gray-400 font-semibold">/ {{ project.projectStatus }}</span>
                            {% endif %}
                        </div>
                        <h2 class="text-white text-xl font-bold leading-tight transition duration-300 group-hover:text-[#7c7cff]">
                            {{ project.title }}
                        </h2>
                    </div>
                    <p class="text-gray-400 leading-relaxed">
                        {{ project.description }}
                    </p>
                    <div class="flex flex-wrap gap-2 mt-auto">
                        {% for technology in project.technologies.all() %}
                            <span class="text-xs text-gray-400 bg-white/[0.06] border border-white/10 px-2.5 py-1 rounded-md">
                                {{ technology.title }}
                            </span>
                        {% endfor %}
                    </div>
                    <div class="pt-4 mt-2 border-t border-white/10 flex items-center justify-between text-sm font-semibold tracking-wide text-white">
                        <span>VIEW PROJECT</span>
                        <i class="fa-solid fa-arrow-up-right-from-square transition duration-300 group-hover:translate-x-1 group-hover:-translate-y-1 group-hover:text-[#7c7cff]" aria-hidden="true"></i>
                    </div>
                </div>
            </a>
        {% endfor %}
    </div>

{% endblock %}